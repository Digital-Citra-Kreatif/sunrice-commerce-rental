{
    "name": "sunrice/commerce-rental",
    "description": "Rentals for Sunrice Commerce: physical units per location, date-range bookings with buffer days, no double booking, rental pricing and rental lifecycle.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "sunrice",
        "laravel",
        "ecommerce",
        "rental",
        "booking"
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../sunrice-commerce",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../sunrice-commerce-multi-locations",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "spatie/laravel-package-tools": "^1.93",
        "sunrice/commerce": "^1.0 || dev-main",
        "sunrice/commerce-multi-locations": "^1.0 || dev-main"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Sunrice\\CommerceRental\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sunrice\\CommerceRental\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sunrice\\CommerceRental\\RentalServiceProvider"
            ],
            "sunrice-plugins": [
                "Sunrice\\CommerceRental\\RentalPlugin"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
